# Tin Can deployment settings. Copy to /opt/tincan/.env on the Pi (bootstrap.sh does this)
# and fill in every value. Never commit the real file; .gitignore excludes .env.
#
# Generate secrets with: openssl rand -hex 24

# ---- images ---------------------------------------------------------------------------
# GitHub user/org that owns the ghcr.io images built by .github/workflows/release.yml.
GHCR_OWNER=hmbootin
# Release tag to run. deploy/update.sh rewrites this line on every OTA update, and keeps the
# previous value in /opt/tincan/.previous-version for --rollback. "stable" always means the
# latest release; a pinned vX.Y.Z freezes the Pi.
TINCAN_VERSION=stable
# Which tag the updater follows: "stable" (latest release) or a fixed tag like v1.2.0.
# Lives in its own file so update.sh can watch it: /opt/tincan/channel. Shown here for docs.
# TINCAN_CHANNEL=stable

# ---- host paths -----------------------------------------------------------------------
# Where recordings, prompts and tincan.db live on the Pi. Mounted as /data in every container.
# Put this on a USB SSD if you have one (see deploy/README.md "USB SSD").
TINCAN_DATA_DIR=/data
# rclone config used by the backup sidecar (see rclone.conf.example).
TINCAN_RCLONE_CONF=/opt/tincan/rclone.conf
# rclone remote the backup copies to. Must end in ":" (remote root) or ":path".
RCLONE_REMOTE=tincan-backup:
# Timezone for quiet hours, logs, and the backup timer.
TZ=America/Chicago

# ---- asterisk <-> backend (ARI) ---------------------------------------------------------
# HTTP basic credentials for Asterisk's ARI. Only reachable from the Pi itself.
ARI_USER=tincan
ARI_PASSWORD=change-me-openssl-rand-hex-24

# ---- the phone (baresip service) ------------------------------------------------------
# SIP password the phone service (baresip) registers with as endpoint "phone". Same value is
# passed to the phone container.
PHONE_SIP_PASSWORD=change-me-openssl-rand-hex-24
# ALSA device of the handset's USB audio adapter, as the phone container sees it. `aplay -l` on
# the Pi: the CM108 adapter is usually card 1 (card 0 is the Pi's headphone jack, which the
# backend uses for the ringer). plughw lets ALSA resample to the 8 kHz baresip asks for.
PHONE_AUDIO_DEVICE=plughw:1,0
# Audio driver module. alsa on the Pi. For a laptop with no sound card use ausine with
# PHONE_AUDIO_DEVICE=440 (a test tone); see phone/README.md.
PHONE_AUDIO_MODULE=alsa
# Where baresip's control socket listens. 0.0.0.0 is required for the backend (bridge network)
# to reach it via host.docker.internal; it is unauthenticated, so this also exposes it to the LAN.
PHONE_CTRL_BIND=0.0.0.0

# ---- SIP trunk (ADR 0004) ---------------------------------------------------------------
# voipms | telnyx | twilio | none. Telnyx and VoIP.ms register from behind NAT; Twilio needs 5060/udp + RTP forwarded. "none" runs the Pi with no outside line: features still work.
TRUNK_PROVIDER=none
# Provider's SIP server, e.g. sip.telnyx.com, chicago1.voip.ms or <your-trunk>.pstn.twilio.com
TRUNK_HOST=
# Trunk SIP username (Telnyx credential, VoIP.ms sub-account, or Twilio credential list user).
TRUNK_USERNAME=
# Trunk SIP password.
TRUNK_PASSWORD=
# Our number on the trunk, digits only (15125550100). Shown as caller ID to family.
TRUNK_DID=
# Optional: public IP (Twilio only) and LAN CIDR (e.g. 192.168.1.0/24) for PJSIP NAT handling.
EXTERNAL_IP=
LOCAL_NET=

# ---- backend ----------------------------------------------------------------------------
# The one shared password parents log in with (POST /api/auth/login).
TINCAN_PARENT_PASSWORD=change-me
# Signs session cookies. Rotate to log everyone out.
TINCAN_SECRET_KEY=change-me-openssl-rand-hex-24

# ---- backup ----------------------------------------------------------------------------
# Optional upload bandwidth cap for the nightly backup, e.g. 2M (bytes/s). "off" = unlimited.
RCLONE_BWLIMIT=off
