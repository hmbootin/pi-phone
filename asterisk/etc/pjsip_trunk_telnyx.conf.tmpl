; Telnyx trunk (credentials connection). Variables: TRUNK_USERNAME / TRUNK_PASSWORD (the SIP
; credential on the connection), TRUNK_HOST (sip.telnyx.com), TRUNK_DID (your number, digits).
; Inbound calls arrive over the registration, so nothing needs to be port-forwarded.
; In the Telnyx portal: SIP Connection type "Credentials", outbound voice profile attached,
; number assigned to the connection. Inbound DIDs arrive as +E.164; outbound dials +E.164.

[trunk-reg]
type = registration
transport = transport-udp
outbound_auth = trunk-auth
server_uri = sip:${TRUNK_HOST}
client_uri = sip:${TRUNK_USERNAME}@${TRUNK_HOST}
contact_user = ${TRUNK_DID}
retry_interval = 30
forbidden_retry_interval = 300
expiration = 300
line = yes
endpoint = trunk

[trunk-auth]
type = auth
auth_type = userpass
username = ${TRUNK_USERNAME}
password = ${TRUNK_PASSWORD}

[trunk]
type = endpoint
context = from-trunk
disallow = all
allow = ulaw
allow = alaw
outbound_auth = trunk-auth
aors = trunk
direct_media = no
rtp_symmetric = yes
force_rport = yes
rewrite_contact = yes
dtmf_mode = rfc4733
from_user = ${TRUNK_USERNAME}
from_domain = ${TRUNK_HOST}
send_pai = yes
trust_id_inbound = yes
language = en

[trunk]
type = aor
contact = sip:${TRUNK_HOST}
qualify_frequency = 60

[trunk]
type = identify
endpoint = trunk
match = ${TRUNK_HOST}
